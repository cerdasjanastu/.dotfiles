#!/usr/bin/env bash
# "Open with" chooser for the `j` picker: pick a command, or type your own.
# Menu lines are "command<TAB>description"; a typed query is used verbatim,
# so multi-word commands like `wc -l` survive.
set -uo pipefail
target=${1:?usage: jump-open <path>}

tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT

printf '%s\t%s\n' \
    "${EDITOR:-nvim}" "edit" \
    "xdg-open"        "system default app" \
    "bat"             "page with syntax highlighting" \
    "less"            "page" \
    "ls -la"          "list" |
fzf +m --height 40% --reverse --prompt='open with> ' \
    --delimiter='\t' --with-nth='1,2' \
    --header="$target" --print-query > "$tmp"
status=${PIPESTATUS[1]}

# Esc / Ctrl-C is 130. Some fzf versions still print the query when you abort,
# and running a command you just escaped out of would be wrong.
[[ $status -eq 0 ]] || exit 0

choice=$(tail -1 "$tmp")
[[ -n $choice ]] || exit 0

cmd=${choice%%$'\t'*}                   # menu line -> command; typed query -> itself
[[ -n $cmd ]] || exit 0

read -ra argv <<<"$cmd"
[[ ${#argv[@]} -gt 0 ]] || exit 0

if [[ ${argv[0]} == xdg-open ]]; then
    setsid xdg-open -- "$target" >/dev/null 2>&1 &   # detach GUI apps
else
    "${argv[@]}" "$target"
fi
